<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.Group?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>


<BorderPane xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="project.AdminDashboard">
   <center>
      <Group>
         <children>
            <AnchorPane prefHeight="568.0" prefWidth="614.0" style="-fx-background-image: url('background5'); -fx-background-repeat: no-repeat; -fx-background-size: cover;">
               <children>
                  <Button fx:id="LogoutButton" layoutX="509.0" layoutY="512.0" mnemonicParsing="false" onAction="#LogoutButtonHandler" prefHeight="35.0" prefWidth="81.0" style="-fx-background-color: #89CFF0;" text="Logout">
                     <font>
                        <Font name="Georgia" size="17.0" />
                     </font>
                  </Button>
                  <ComboBox fx:id="DisplayEventsComboBox" layoutX="12.0" layoutY="232.0" onAction="#DisplayEventsHandler" prefHeight="35.0" prefWidth="184.0" promptText="Events" style="-fx-background-color: #5ca9e6;" />
                  <ComboBox fx:id="DisplayAttendeesComboBox" layoutX="216.0" layoutY="232.0" onAction="#DisplayAttendeesHandler" prefHeight="35.0" prefWidth="183.0" promptText="Attendees" style="-fx-background-color: #5ca9e6;" />
                  <ComboBox fx:id="DisplayOrganizersComboBox" layoutX="418.0" layoutY="232.0" onAction="#DisplayOrganizersHandler" prefHeight="35.0" prefWidth="183.0" promptText="Organizers" style="-fx-background-color: #5ca9e6;" />
               </children>
            </AnchorPane>
         </children>
      </Group>
   </center>
   <left>
      <VBox prefHeight="495.0" prefWidth="305.0" style="-fx-background-image: url(&quot;background2.jpeg&quot;); -fx-background-repeat: no-repeat; -fx-background-size: cover;" BorderPane.alignment="CENTER">
         <children>
            <Label prefHeight="41.0" prefWidth="221.0" text="Admin" textFill="WHITE">
               <font>
                  <Font name="Georgia Bold Italic" size="36.0" />
               </font>
               <VBox.margin>
                  <Insets left="23.0" top="40.0" />
               </VBox.margin>
            </Label>
            <Label prefHeight="52.0" prefWidth="244.0" text="Dashboard" textFill="WHITE">
               <font>
                  <Font name="Georgia Bold Italic" size="36.0" />
               </font>
               <VBox.margin>
                  <Insets bottom="25.0" left="23.0" />
               </VBox.margin>
            </Label>
         </children>
      </VBox>
   </left>
   <right>
      <Pane prefHeight="200.0" prefWidth="200.0" BorderPane.alignment="CENTER" />
   </right>
</BorderPane>
