<BorderPane prefHeight="538.0" prefWidth="832.0" xmlns="http://javafx.com/javafx/23.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="project.AttendeeDashboardController">
   <center>
      <Group>
         <children>
            <AnchorPane layoutX="-31.0" prefHeight="543.0" prefWidth="678.0">
