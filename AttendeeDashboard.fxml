                    <Button fx:id="LogOutButton" layoutX="546.0" layoutY="480.0" mnemonicParsing="false" onAction="#LogOutHandler" prefHeight="35.0" prefWidth="118.0" style="-fx-background-color: #89CFF0; -fx-border-color: black;" text="Log Out">
                     <font>
                        <Font name="Georgia" size="17.0" />
                     </font>
                  </Button>
                    <StackPane layoutX="419.0" layoutY="295.0" prefHeight="0.0" prefWidth="0.0" />
                    <Button fx:id="AttendeeAccount" layoutX="207.0" layoutY="278.0" mnemonicParsing="false" onAction="#AttendeeAccountHandler" prefHeight="35.0" prefWidth="265.0" style="-fx-background-color: #5ca9e6; -fx-border-color: black;" text="View My Account">
                     <font>
                        <Font name="Georgia" size="17.0" />
                     </font>
                  </Button>
                    <ComboBox fx:id="combobox" layoutX="207.0" layoutY="333.0" onAction="#comboboxhandler" prefHeight="36.0" prefWidth="265.0" promptText="View My Registered Events" style="-fx-background-color: #5ca9e6; -fx-border-color: black;" />
